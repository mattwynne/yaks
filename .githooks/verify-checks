#!/usr/bin/env bash
# Verifies that dev check has passed for the current content.
# Used by git hooks (pre-commit, pre-merge-commit, pre-push)

set -e

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)

# shellcheck source=../bin/dev
YX_DEV_SOURCE_ONLY=1 . "$repo_root/bin/dev"

verify_check_record
