#!/usr/bin/env python3
"""Compare real yak maps made with old and new yx binaries."""

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import hashlib
import json
import os
from pathlib import Path
import statistics
import subprocess
import tempfile
import time


def summarize(rows):
    summary = {}
    for variant in ("old", "new"):
        attempts = [row for row in rows if row["variant"] == variant]
        if not attempts:
            continue
        passed = sum(row["outcome"] == "pass" for row in attempts)
        summary[variant] = {
            "attempts": len(attempts),
            "passed": passed,
            "failed": sum(row["outcome"] == "fail" for row in attempts),
            "errors": sum(row["outcome"] == "error" for row in attempts),
            "review": sum(row["outcome"] == "review" for row in attempts),
            "pass_rate": passed / len(attempts),
            "median_seconds": statistics.median(row["seconds"] for row in attempts),
        }
    return summary


def build_binary(root, revision, variant, output, target):
    sha = subprocess.check_output(
        ["git", "rev-parse", revision + "^{commit}"], cwd=root, text=True
    ).strip()
    source = output / ("source-" + variant)
    source.mkdir()
    archive = output / (variant + ".tar")
    with archive.open("wb") as stream:
        subprocess.run(["git", "archive", sha], cwd=root, stdout=stream, check=True)
    subprocess.run(["tar", "-xf", str(archive), "-C", str(source)], check=True)
    # Git archives retain commit times. Refresh inputs so Cargo cannot mistake
    # a second revision for unchanged sources in the shared target directory.
    for path in source.rglob("*"):
        if path.is_file():
            path.touch()
    print(f"Building {variant}: {sha}", flush=True)
    with (output / (variant + "-build.log")).open("w") as log:
        subprocess.run(
            ["cargo", "build", "--locked", "--target-dir", str(target)],
            cwd=source, stdout=log, stderr=subprocess.STDOUT, check=True,
        )
    binary = output / ("yx-" + variant)
    # Copy before building the other revision into the shared target directory.
    import shutil
    shutil.copy2(target / "debug/yx", binary)
    return binary, sha


def build_current_binary(root, output):
    """Build the working tree, including uncommitted help edits."""
    import shutil
    sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    print("Building current working copy", flush=True)
    with (output / "new-build.log").open("w") as log:
        subprocess.run(["cargo", "build", "--locked", "--target-dir", str(root / "target")],
                       cwd=root, stdout=log, stderr=subprocess.STDOUT, check=True)
    binary = output / "yx-new"
    shutil.copy2(root / "target/debug/yx", binary)
    return binary, sha


def snapshot_help(binary, output, variant):
    environment = dict(os.environ, CLAUDECODE="1")
    sections = []
    for name, args in (
        ("top", ["--help"]), ("add", ["add", "--help"]),
        ("move", ["move", "--help"]), ("blocker-add", ["blocker", "add", "--help"]),
    ):
        help_text = subprocess.check_output([str(binary), *args], env=environment, text=True)
        (output / f"{variant}-help-{name}.txt").write_text(help_text)
        sections.append(help_text)
    return "\n".join(sections)


def run_attempt(root, binary, variant, index, output, model, timeout):
    directory = output / f"{variant}-{index:02d}"
    directory.mkdir()
    environment = os.environ.copy()
    environment.update({
        "YX_DEV_SOURCE_ONLY": "1",
        "YX_EVAL_PROVIDER": "codex",
        "YX_EVAL_SKIP_BUILD": "1",
        "YX_EVAL_BINARY": str(binary),
        "YX_EVAL_ARTIFACTS": str(directory / "run"),
        "YX_EVAL_MODEL": model,
    })
    started = time.monotonic()
    status = None
    with (directory / "runner.log").open("w") as log:
        # A process group lets the timeout also stop the model subprocess.
        import signal
        process = subprocess.Popen(
            ["bash", "-c", 'source "$1"; eval-dependency-help',
             "eval", str(root / "bin/dev")],
            cwd=root, env=environment, stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        try:
            status = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
    try:
        assessment = json.loads((directory / "run/assessment.json").read_text())
        expected_status = {"pass": 0, "fail": 1, "review": 2}
        outcome = assessment["outcome"]
        if expected_status.get(outcome) != status:
            outcome = "error"
    except (OSError, ValueError, KeyError):
        outcome = "error"
        assessment = {"reasons": ["Agent run or map inspection did not complete"]}
    row = {
        "variant": variant, "attempt": index, "outcome": outcome,
        "seconds": round(time.monotonic() - started, 2), "exit_code": status,
        "artifacts": str(directory),
        "assessment": assessment,
    }
    (directory / "result.json").write_text(json.dumps(row, indent=2) + "\n")
    return row


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runs", type=int, default=8, help="Attempts per version")
    parser.add_argument("--jobs", type=int, default=4, help="Concurrent attempts in total")
    parser.add_argument("--old-ref", default="d5c4bc4", help="Revision before help changes")
    parser.add_argument("--new-ref", default="HEAD")
    parser.add_argument("--current-only", action="store_true", help="Do not run a baseline")
    parser.add_argument("--working-tree", action="store_true", help="Include uncommitted help edits")
    parser.add_argument("--model", default="gpt-6.1-sol", help="Same model for both versions")
    parser.add_argument("--timeout", type=int, default=300, help="Seconds per attempt")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--target-dir", type=Path, help="Reusable baseline Cargo build cache")
    args = parser.parse_args()
    if min(args.runs, args.jobs, args.timeout) < 1:
        parser.error("runs, jobs, and timeout must be positive")
    root = Path(__file__).resolve().parents[1]
    if args.output:
        output = args.output.resolve()
        if output.exists() and any(output.iterdir()):
            parser.error("output directory must be empty")
        output.mkdir(parents=True, exist_ok=True)
    else:
        parent = root / "eval-results"
        parent.mkdir(exist_ok=True)
        output = Path(tempfile.mkdtemp(prefix=time.strftime("%Y%m%d-%H%M%S-"), dir=parent))
    print(f"Evaluation artifacts: {output}", flush=True)
    build_started = time.monotonic()
    binaries = {}
    revisions = {}
    helps = {}
    if not args.current_only:
        target = args.target_dir.resolve() if args.target_dir else root / "target/eval-baseline"
        binaries["old"], revisions["old"] = build_binary(root, args.old_ref, "old", output, target)
        helps["old"] = snapshot_help(binaries["old"], output, "old")
    if args.working_tree or args.current_only:
        binaries["new"], revisions["new"] = build_current_binary(root, output)
    else:
        target = output / "current-build"
        binaries["new"], revisions["new"] = build_binary(root, args.new_ref, "new", output, target)
    helps["new"] = snapshot_help(binaries["new"], output, "new")
    if "old" in helps and helps["old"] == helps["new"]:
        raise RuntimeError("Old and new help are identical; refusing to run a misleading comparison")
    metadata = {
        "revisions": revisions, "model": args.model,
        "working_tree": args.working_tree or args.current_only,
        "runs_per_version": args.runs, "jobs": args.jobs, "timeout": args.timeout,
        "build_seconds": round(time.monotonic() - build_started, 2),
        "binary_sha256": {
            key: hashlib.sha256(binary.read_bytes()).hexdigest()
            for key, binary in binaries.items()
        },
        "brief_sha256": hashlib.sha256(
            (root / "evals/prerequisite-nesting/task.md").read_bytes()).hexdigest(),
        "grader_sha256": hashlib.sha256(
            (root / "evals/prerequisite-nesting/grade.py").read_bytes()).hexdigest(),
        "git_status": subprocess.check_output(
            ["git", "status", "--porcelain"], cwd=root, text=True),
    }
    (output / "metadata.json").write_text(json.dumps(metadata, indent=2) + "\n")
    rows = []
    started = time.monotonic()
    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        futures = [
            pool.submit(run_attempt, root, binary, variant, index, output, args.model, args.timeout)
            for index in range(1, args.runs + 1)
            for variant, binary in binaries.items()
        ]
        for future in as_completed(futures):
            row = future.result()
            rows.append(row)
            print(f'{row["variant"]} {row["attempt"]:02d}: {row["outcome"]} ({row["seconds"]}s)', flush=True)
    report = {
        **metadata, "eval_seconds": round(time.monotonic() - started, 2),
        "summary": summarize(rows),
        "attempts": sorted(rows, key=lambda row: (row["variant"], row["attempt"])),
    }
    (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
    lines = [
        "# Prose-to-yak-map eval", "",
        f"Model: {args.model}. Attempts per version: {args.runs}. Concurrent attempts: {args.jobs}.",
        "", "| Help | Passed | Incorrect maps | Needs review | Execution errors | Median seconds |",
        "| --- | ---: | ---: | ---: | ---: | ---: |",
    ]
    for variant, summary in report["summary"].items():
        label = "current" if variant == "new" else "baseline"
        lines.append(
            f'| {label} | {summary["passed"]}/{summary["attempts"]} | '
            f'{summary["failed"]} | {summary["review"]} | {summary["errors"]} | '
            f'{summary["median_seconds"]:.1f} |'
        )
    lines.extend([
        "", f"Revisions: {json.dumps(revisions)}",
        f'Build time: {metadata["build_seconds"]} seconds.',
        f'Evaluation wall time: {report["eval_seconds"]} seconds.', "",
        "Each attempt starts empty and uses the same prose and structural grader.",
        "Task roles are recognized from common English action words; ambiguous maps need review.",
        "All attempts remain in the denominator. Failed attempts are not retried.",
        "Inspect each run/assessment.json and map.json for details.",
        "Small samples on a selected task are descriptive, not conclusive.",
    ])
    (output / "report.md").write_text("\n".join(lines) + "\n")
    print("\n".join(lines), flush=True)
    current = report["summary"]["new"]
    if current["errors"] or current["review"]:
        return 2
    return 1 if current["failed"] else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, subprocess.CalledProcessError, RuntimeError) as error:
        print(f"Eval error: {error}", file=__import__("sys").stderr)
        raise SystemExit(2)
